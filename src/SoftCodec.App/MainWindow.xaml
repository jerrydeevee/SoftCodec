<Window x:Class="SoftCodec.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="SoftCodec · Radio Aa en Hunze" Width="1320" Height="850" MinWidth="1050" MinHeight="700" Topmost="{Binding AlwaysOnTop}">
<DockPanel Margin="24">
<Grid DockPanel.Dock="Top" Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SOFTCODEC" FontSize="26" FontWeight="Bold"/><TextBlock Text="RADIO AA EN HUNZE  /  LIVE CONTRIBUTION" Foreground="#86A4BF"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><CheckBox Content="Altijd boven" IsChecked="{Binding AlwaysOnTop}" VerticalAlignment="Center" Margin="0,0,20,0"/><Button Content="Ontvanger starten" Command="{Binding StartCommand}"/><Button Content="Stoppen" Command="{Binding StopCommand}"/></StackPanel></Grid>
<Border DockPanel.Dock="Bottom" Background="#1F2C3C" Padding="12" Margin="0,16,0,0"><StackPanel><TextBlock Text="{Binding Alarm}" Foreground="#EDC78D" TextWrapping="Wrap"/><TextBlock Text="{Binding Listener}" Foreground="#89A6C2"/></StackPanel></Border>
<TabControl>
<TabItem Header="Studio"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
<Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Status}" FontSize="32" FontWeight="Bold" Foreground="#52D9B0"/><TextBlock Text="{Binding RemoteName}" FontSize="23"/><TextBlock Text="{Binding Codec}" Foreground="#9DB4C9"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Duration}" FontFamily="Consolas" FontSize="38"/></Grid>
<Grid Margin="0,24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
<GroupBox Header="REMOTE · NAAR MENGTAFEL"><StackPanel><ProgressBar Value="{Binding RemoteLevel}" Maximum="60" Height="30" Foreground="#52D9B0" Background="#0D141F"/><TextBlock Text="{Binding RemoteDb}" FontFamily="Consolas" FontSize="21"/></StackPanel></GroupBox>
<GroupBox Grid.Column="1" Header="RETOUR · MIX-MINUS"><StackPanel><ProgressBar Value="{Binding ReturnLevel}" Maximum="60" Height="30" Foreground="#78B3F2" Background="#0D141F"/><TextBlock Text="{Binding ReturnDb}" FontFamily="Consolas" FontSize="21"/></StackPanel></GroupBox></Grid>
<TextBlock Text="{Binding Metrics}" FontFamily="Consolas" FontSize="16" LineHeight="30"/><Border Background="#101B28" Padding="10" Margin="0,16"><StackPanel><TextBlock Text="ONTVANGSTBUFFER · LAATSTE 60 SECONDEN" Foreground="#8DAAC4"/><Viewbox Stretch="Fill" Height="100"><Canvas Width="900" Height="100"><Polyline Points="{Binding BufferPoints}" Stroke="#52D9B0" StrokeThickness="2"/></Canvas></Viewbox></StackPanel></Border>
<WrapPanel><Button Content="Opnemen" Command="{Binding AnswerCommand}"/><Button Content="Weigeren" Command="{Binding RejectCommand}"/><Button Content="Ophangen" Background="#8D3944" Command="{Binding HangupCommand}"/><CheckBox Content="Retour dempen" IsChecked="{Binding Muted}" VerticalAlignment="Center" Margin="15,0"/></WrapPanel>
<Grid Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Target, UpdateSourceTrigger=PropertyChanged}" ToolTip="sip:verslaggever@adres"/><Button Grid.Column="1" Content="Uitbellen" Command="{Binding PlaceCallCommand}" Margin="12,3,0,10"/></Grid>
</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Instellingen"><DockPanel Margin="20"><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"><Button Content="Instellingen en wachtwoorden opslaan" Click="SaveSettings_Click"/><TextBlock Text="Stop de ontvanger voordat je wijzigingen opslaat." VerticalAlignment="Center" Foreground="#98ADC2"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><GroupBox Header="Netwerk"><StackPanel><TextBlock Text="Studionaam"/><TextBox Text="{Binding Settings.DisplayName, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Publiek IPv4-adres (bij portforward)"/><TextBox Text="{Binding Settings.AdvertisedIp, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="STUN-server"/><TextBox Text="{Binding Settings.StunServer, UpdateSourceTrigger=PropertyChanged}"/><Button Content="Publiek IP via STUN bepalen" Command="{Binding DetectIpCommand}"/><TextBlock Text="Lokaal bindadres"/><TextBox Text="{Binding Settings.BindAddress, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="SIP-poort"/><TextBox Text="{Binding Settings.SipPort, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="RTP-poort"/><TextBox Text="{Binding Settings.RtpPort, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="RTCP-poort"/><TextBox Text="{Binding Settings.RtcpPort, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="DSCP"/><TextBox Text="{Binding Settings.Dscp, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Symmetric RTP" IsChecked="{Binding Settings.SymmetricRtp}"/><CheckBox Content="Automatisch opnemen" IsChecked="{Binding Settings.AutoAnswer}"/><TextBlock Text="Time-out zonder media (seconden)"/><TextBox Text="{Binding Settings.MediaTimeout, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Maximale gespreksduur (0 = onbeperkt)"/><TextBox Text="{Binding Settings.MaxCallSeconds, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></GroupBox><GroupBox Header="SIP-registratie"><StackPanel><CheckBox Content="Registreren bij SIP-provider" IsChecked="{Binding Settings.RegisterEnabled}"/><TextBlock Text="Registrar"/><TextBox Text="{Binding Settings.Registrar, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Gebruikersnaam"/><TextBox Text="{Binding Settings.RegisterUser, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Registrarwachtwoord (leeg = behouden)"/><PasswordBox x:Name="RegisterPassword" Padding="8" Margin="0,3,0,10"/><TextBlock Text="Outbound proxy"/><TextBox Text="{Binding Settings.OutboundProxy, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Registratieduur (seconden)"/><TextBox Text="{Binding Settings.RegisterExpiry, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></GroupBox><GroupBox Header="Opname en alarmen"><StackPanel><CheckBox Content="Gesprekken opnemen als 24-bit WAV" IsChecked="{Binding Settings.RecordingEnabled}"/><CheckBox Content="Ook mix-minus opnemen (apart bestand)" IsChecked="{Binding Settings.RecordReturn}"/><TextBlock Text="Opnamemap"/><TextBox Text="{Binding Settings.RecordingDirectory, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Stiltedrempel (dBFS)"/><TextBox Text="{Binding Settings.SilenceDb, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Stiltealarm na (seconden)"/><TextBox Text="{Binding Settings.SilenceSeconds, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></GroupBox></StackPanel><StackPanel Grid.Column="1"><GroupBox Header="Audio"><StackPanel><TextBlock Text="Uitgang naar mengtafel"/><ComboBox ItemsSource="{Binding RenderDevices}" SelectedItem="{Binding Settings.RenderDevice}" DisplayMemberPath="Name"/><TextBlock Text="Mix-minus-ingang"/><ComboBox ItemsSource="{Binding CaptureDevices}" SelectedItem="{Binding Settings.CaptureDevice}" DisplayMemberPath="Name"/><TextBlock Text="Uitgangskanalen (0 = eerste kanaal)"/><TextBox Text="{Binding Settings.RenderChannels, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Capturekanalen"/><TextBox Text="{Binding Settings.CaptureChannels, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="WASAPI exclusive, shared als fallback" IsChecked="{Binding Settings.Exclusive}"/><CheckBox Content="Raw audio" IsChecked="{Binding Settings.Raw}"/><TextBlock Text="Gewenste latency (ms)"/><TextBox Text="{Binding Settings.Latency, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></GroupBox><Button Content="Testtoon · 1 kHz / −18 dBFS / 2 s" Command="{Binding TestToneCommand}"/><GroupBox Header="Beveiliging"><StackPanel><CheckBox Content="SIP digest-authenticatie" IsChecked="{Binding Settings.DigestEnabled}"/><TextBlock Text="Gebruikersnaam"/><TextBox Text="{Binding Settings.DigestUser, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Realm"/><TextBox Text="{Binding Settings.DigestRealm, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Nieuw digest-wachtwoord (leeg = behouden)"/><PasswordBox x:Name="DigestPassword" Padding="8" Margin="0,3,0,10"/><TextBlock Text="Toegestane IPv4/CIDR (één per regel)"/><TextBox Text="{Binding Settings.Allowlist, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="INVITE-limiet per minuut per IP"/><TextBox Text="{Binding Settings.RateLimit, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Bekende SIP-scanners negeren" IsChecked="{Binding Settings.DropScanners}"/></StackPanel></GroupBox><GroupBox Header="Codecs"><StackPanel><TextBlock Text="Codecprioriteit (komma gescheiden)"/><TextBox Text="{Binding Settings.Priority, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Opus bitrate (bit/s)"/><TextBox Text="{Binding Settings.Bitrate, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Opus framelengte (10, 20 of 40 ms)"/><TextBox Text="{Binding Settings.Ptime, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Opus complexiteit (0–10)"/><TextBox Text="{Binding Settings.Complexity, UpdateSourceTrigger=PropertyChanged}"/><CheckBox Content="Stereo" IsChecked="{Binding Settings.Stereo}"/><CheckBox Content="Opus FEC" IsChecked="{Binding Settings.Fec}"/><CheckBox Content="DTX" IsChecked="{Binding Settings.Dtx}"/><CheckBox Content="Constante bitrate" IsChecked="{Binding Settings.Cbr}"/></StackPanel></GroupBox><GroupBox Header="Jitterbuffer"><StackPanel><CheckBox Content="Adaptieve jitterbuffer" IsChecked="{Binding Settings.Adaptive}"/><TextBlock Text="Minimum (ms)"/><TextBox Text="{Binding Settings.JitterMin, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Startdoel (ms)"/><TextBox Text="{Binding Settings.JitterTarget, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="Maximum (ms)"/><TextBox Text="{Binding Settings.JitterMax, UpdateSourceTrigger=PropertyChanged}"/></StackPanel></GroupBox></StackPanel></Grid></ScrollViewer></DockPanel></TabItem>
<TabItem Header="Verslaggevers"><DockPanel Margin="20"><WrapPanel DockPanel.Dock="Top"><Button Content="Nieuw profiel" Command="{Binding AddProfileCommand}"/><Button Content="Verwijderen" Command="{Binding RemoveProfileCommand}"/><Button Content="Bel geselecteerde verslaggever" Command="{Binding CallProfileCommand}"/><Button Content="Profielen opslaan" Command="{Binding SaveCommand}"/></WrapPanel><DataGrid ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" AutoGenerateColumns="False" CanUserAddRows="False" Background="#E6EDF4" Foreground="#142031" RowHeight="38"><DataGrid.Columns><DataGridTextColumn Header="Naam" Binding="{Binding Name}" Width="180"/><DataGridTextColumn Header="SIP-bestemming" Binding="{Binding SipUri}" Width="220"/><DataGridTextColumn Header="IP/CIDR" Binding="{Binding AllowedCidrs}" Width="160"/><DataGridTextColumn Header="From bevat" Binding="{Binding ExpectedFrom}" Width="130"/><DataGridCheckBoxColumn Header="Auto" Binding="{Binding AutoAnswer}"/><DataGridTextColumn Header="Codecs" Binding="{Binding CodecPriority}" Width="180"/><DataGridTextColumn Header="Notities" Binding="{Binding Notes}" Width="*"/></DataGrid.Columns></DataGrid></DockPanel></TabItem>
<TabItem Header="Logboek"><DockPanel Margin="20"><TextBox DockPanel.Dock="Top" Text="{Binding LogFilter, UpdateSourceTrigger=PropertyChanged}" ToolTip="Filter op tekst of niveau"/><ListBox ItemsSource="{Binding Logs}" FontFamily="Consolas" FontSize="12" Background="#101B28" Foreground="#BDCFE1" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Auto"/></DockPanel></TabItem>
<TabItem Header="Info"><StackPanel Margin="30"><TextBlock Text="SoftCodec" FontSize="30" FontWeight="Bold"/><TextBlock Text="{Binding Version}"/><TextBlock Text="SIP/RTP-studiocodec met aparte mix-minus. Gebruik Comrex in EBU 3326/SIP-modus." TextWrapping="Wrap"/><TextBlock Text="Test de verbinding met de veldcodec vóór gebruik in een uitzending."/><Button Content="Configuratie- en logmap openen" Command="{Binding OpenFolderCommand}" HorizontalAlignment="Left"/><Button Content="Diagnosepakket naar bureaublad" Command="{Binding DiagnosticsCommand}" HorizontalAlignment="Left"/><TextBlock Text="Sluiten minimaliseert naar het systeemvak. Kies Afsluiten via het systeemvak om de toepassing te beëindigen." TextWrapping="Wrap"/></StackPanel></TabItem>
</TabControl></DockPanel></Window>