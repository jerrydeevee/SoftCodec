<Application x:Class="SoftCodec.App.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown"><Application.Resources>
<SolidColorBrush x:Key="Panel" Color="#18222F"/>
<Style TargetType="Window"><Setter Property="Background" Value="#0D141F"/><Setter Property="Foreground" Value="#E8EFF7"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/></Style>
<Style TargetType="TextBlock"><Setter Property="Margin" Value="0,5"/></Style>
<Style TargetType="Button"><Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,5,10,5"/><Setter Property="Background" Value="#294660"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style>
<Style TargetType="TextBox"><Setter Property="Padding" Value="9,6"/><Setter Property="Margin" Value="0,3,0,10"/><Setter Property="Background" Value="#101B28"/><Setter Property="Foreground" Value="#E8EFF7"/><Setter Property="BorderBrush" Value="#3B5064"/><Setter Property="CaretBrush" Value="White"/></Style>
<Style TargetType="CheckBox"><Setter Property="Margin" Value="0,8,0,8"/><Setter Property="Foreground" Value="#E8EFF7"/></Style>
<Style TargetType="TabControl"><Setter Property="Background" Value="#18222F"/><Setter Property="BorderBrush" Value="#294052"/></Style>
<Style TargetType="TabItem"><Setter Property="Padding" Value="18,10"/></Style>
<Style TargetType="GroupBox"><Setter Property="Foreground" Value="#C5D7E9"/><Setter Property="Margin" Value="0,8,16,8"/><Setter Property="Padding" Value="16"/><Setter Property="BorderBrush" Value="#354A60"/></Style>
<Style TargetType="ComboBox"><Setter Property="Margin" Value="0,3,0,12"/><Setter Property="Padding" Value="8"/><Setter Property="Foreground" Value="#101820"/></Style>

<Style x:Key="HardwareButton" TargetType="Button">
 <Setter Property="Foreground" Value="#ECECE8"/><Setter Property="Background" Value="#303538"/><Setter Property="Padding" Value="18,12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/><Setter Property="Margin" Value="0,5,10,5"/><Setter Property="MinHeight" Value="48"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Case" Background="{TemplateBinding Background}" BorderBrush="#697074" BorderThickness="1,1,1,3" CornerRadius="5" Padding="{TemplateBinding Padding}"><Border.Effect><DropShadowEffect BlurRadius="5" ShadowDepth="2" Opacity="0.45"/></Border.Effect><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Case" Property="BorderBrush" Value="#CAD4D0"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Case" Property="BorderThickness" Value="1,3,1,1"/><Setter TargetName="Case" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Case" Property="BorderBrush" Value="#8ADFC2"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Case" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="PanelLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#929E9C"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
<Style x:Key="StatusLamp" TargetType="Ellipse"><Setter Property="Width" Value="9"/><Setter Property="Height" Value="9"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Fill" Value="#3C4542"/><Style.Triggers><DataTrigger Binding="{Binding Running}" Value="True"><Setter Property="Fill" Value="#84D088"/></DataTrigger></Style.Triggers></Style>
</Application.Resources></Application>